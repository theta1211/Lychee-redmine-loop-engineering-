<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode 用の設定。webapp/ をIISサイトの物理パスとして指定する
  （scripts/setup-iis.ps1が自動生成・配置する。手動構築の場合はこのファイルを
  そのままwebapp/直下に置けばよい）。

  前提: IIS本体・iisnode・URL Rewriteモジュールが導入済みであること。
-->
<configuration>
  <system.webServer>
    <!--
      WebDAV Publishingモジュールが有効だと、PUT/DELETEリクエストを
      iisnodeより先に横取りしてしまい、本アプリのAPI（PUT /api/queue/:id/order 等）が
      すべて失敗する。無効化しておく。
    -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="dist/server.js" verb="*" modules="iisnode" />
    </handlers>

    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>

    <rewrite>
      <rules>
        <rule name="DevLoopWebApp">
          <match url="/*" />
          <!--
            IISが認証したWindowsアカウント名(LOGON_USER)を、クライアントが
            自称したX-Remote-Userヘッダーを上書きする形で注入する。
            webapp/src/auth.ts はこのヘッダーの値をそのまま利用者名として扱うため、
            ここでの上書きがなりすまし防止の要になる。
          -->
          <serverVariables>
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="dist/server.js" />
        </rule>
      </rules>
      <allowedServerVariables>
        <add name="HTTP_X_REMOTE_USER" />
      </allowedServerVariables>
    </rewrite>

    <iisnode watchedFiles="web.config;dist\*.js" nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
